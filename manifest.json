{
  "manifest_version": 3,
  "name": "md telescribe",
  "version": "1.6.9",
  "description": "Record telemedicine or in-person visits and generate AI-powered SOAP notes with md telescribe.",
  "permissions": [
    "tabCapture",
    "activeTab",
    "scripting",
    "storage",
    "offscreen",
    "downloads",
    "tabs",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://huggingface.co/*",
    "https://cdn.jsdelivr.net/*",
    "https://api.mdtelescribe.com/*",
    "https://mdtelescribe.com/*",
    "http://localhost:5000/*",
    "http://localhost:3000/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.js",
        "config.js",
        "extension-ui.css",
        "icons/icon48.png",
        "icons/icon128.png",
        "icons/logo.png"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://zoom.us/*",
        "https://*.zoom.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.webex.com/*",
        "https://*.doxy.me/*",
        "https://doxy.me/*"
      ],
      "css": ["meeting-prompt.css"],
      "js": ["meeting-prompt.js"],
      "run_at": "document_idle"
    }
  ]
}
